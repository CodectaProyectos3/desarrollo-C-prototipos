<Window x:Class="Prototipo.Usuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prototipo"
        mc:Ignorable="d"
       Title="Crear Cuenta"
        WindowStyle="None"
        Background="#FF1E1E2F"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="650" Width="400">

    <Grid Background="#AA1E1E2F">
        <!-- Botón cerrar -->
        <Button Content="✖" Width="30" Height="30"
        Background="Transparent"
        BorderBrush="Transparent"
        Foreground="White"
        FontSize="14"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,10,10,0"
        Click="BtnClose_click"
        Cursor="Hand"/>


        <Border Background="#282D33"
        BorderBrush="#3A4149"
        BorderThickness="2"
        CornerRadius="20"
        Padding="30"
        Margin="10,40,10,29">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <Image Source="https://cdn-icons-png.flaticon.com/512/1828/1828490.png"
               Height="99"
               Margin="0,0,0,20"
               Stretch="UniformToFill"
               ClipToBounds="True"
               HorizontalAlignment="Center"/>

                <TextBlock Text="Registrarse"
                   FontSize="22"
                   Foreground="White"
                   Margin="0,0,0,10"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   FontFamily="Poppins"/>

                <!-- Nombre de usuario -->
                <Label Content="Nombre de usuario:" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
                <TextBox x:Name="txtUsuario"
                 Margin="0,0,0,8"
                 FontSize="13"
                 Padding="8"
                 Height="32"
                 Background="#333"
                 Foreground="White"
                 BorderThickness="0"
                 BorderBrush="#555"/>

                <!-- Correo electrónico -->
                <Label Content="Correo electrónico:" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
                <TextBox x:Name="txtCorreo"
                 Margin="0,0,0,8"
                 FontSize="13"
                 Padding="8"
                 Height="36"
                 Background="#333"
                 Foreground="White"
                 BorderThickness="0"
                 BorderBrush="#555"/>

                <!-- Contraseña -->
                <Label Content="Contraseña:" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
                <PasswordBox x:Name="txtPassword"
                     FontSize="13"
                     Padding="8"
                     Height="32"
                     Background="#333"
                     Foreground="White"
                     BorderThickness="0"
                     BorderBrush="#555"/>

                <!-- Botón registrar -->
                <Button Content="Registrarse"
                Height="38"
                FontSize="15"
                Background="#7B5BFE"
                Foreground="White"
                FontWeight="Bold"
                Cursor="Hand"
                BorderBrush="Transparent"
                BorderThickness="0"
                Margin="0,10,0,5"
                FontFamily="Poppins"
                Click="Registrar_Click"/>

                <!-- ¿Ya tienes cuenta? -->
                <TextBlock Text="¿Ya tienes cuenta?"
                   Foreground="LightGray"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,5"
                   FontFamily="Poppins"/>

                <Button Content="Iniciar sesión"
                Height="34"
                FontSize="14"
                Background="#FF2688A7"
                Foreground="White"
                Cursor="Hand"
                BorderBrush="Transparent"
                BorderThickness="0"
                FontFamily="Poppins"
                FontWeight="Bold"
                Click="IniciarSesion_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
