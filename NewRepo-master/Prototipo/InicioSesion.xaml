<Window x:Class="Prototipo.InicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prototipo"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="500" Width="350"
        Background="#FF1E1E2F">
    <Grid Background="#AA1E1E2F">
        <!-- Círculo cerrar -->
        <Button Content="✖" Width="30" Height="30"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="White"
                FontSize="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Click="Close_Click"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <!-- Logo -->
            <Image Source="C:\Users\CODETA01\source\repos\jyp1\Prototipo\jyp.png"
                   Width="50" Height="70" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <!-- Título -->
            <TextBlock Text="JP Perifericos SAC"
                       FontSize="22"
                       Foreground="White"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" FontFamily="Poppins"/>
            <TextBlock Text="Especialistas TI en Hardware y Software"
                       FontSize="12"
                       Foreground="LightGray"
                       TextAlignment="Center"
                       Margin="0,5,0,20" FontFamily="Poppins"/>

            <!-- Campo Usuario -->
            <Label Content="Usuario" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
            <TextBox x:Name="txtUsuario"
                     Height="35"
                     Padding="10"
                     FontSize="14"
                     BorderThickness="0"
                     Background="#333"
                     Foreground="White"
                     Margin="0,0,0,10"
                     BorderBrush="#555" Width="253"
                     />

            <Label Content="Correo electrónico" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
            <TextBox x:Name="txtCorreo"
                     Height="38"
                     Padding="10"
                     FontSize="14"
                     BorderThickness="0"
                     Background="#333"
                     Foreground="White"
                     Margin="0,0,0,10"
                     BorderBrush="#555"
                     />

            <!-- Campo Contraseña -->
            <Label Content="Contraseña" Foreground="White" Margin="0,0,0,5" FontFamily="Poppins"/>
            <PasswordBox x:Name="txtContra"
                         Height="39"
                         Padding="10"
                         FontSize="14"
                         BorderThickness="0"
                         Background="#333"
                         Foreground="White"
                         Margin="0,0,0,20"
                         BorderBrush="#555"
                         />

            <!-- Botón de inicio -->
            <Button Content="Iniciar sesion"
                    Height="40"
                    Background="#7B5BFE"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    FontSize="14"
                    Click="Login_Click"
                    Margin="0,0,0,10"
                    BorderThickness="0" FontFamily="Poppins"
                    />

            <!-- Enlace contraseña -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Olvidaste tu contraseña?" Foreground="LightGray" FontFamily="Poppins"/>
                <TextBlock Text=" Cambiar"
                           Foreground="#7B5BFE"
                           FontWeight="Bold"
                           Cursor="Hand"
                           FontFamily="Poppins"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
