<Window x:Class="Prototipo.Red"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="x"
        Title="Monitor de Red"
        Height="300" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1e1e2f"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="10" BorderThickness="1" Margin="10">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Purple" Offset="0"/>
                <GradientStop Color="Blue" Offset="0.5"/>
                <GradientStop Color="Green" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Logo + Nombre + Botones -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Image Source="C:\Users\CODETA01\source\repos\jyp1\Prototipo\logojp.png"
                       Width="32" Height="32" Margin="0,0,10,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="JyP Perifericos S.A.C"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="White"
                           FontFamily="Poppins"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="▁" Width="28" Height="28"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="White" FontSize="14"
                            Click="BtnPeque_Click" Cursor="Hand"/>
                    <Button Content="✖" Width="28" Height="28"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="White" FontSize="14"
                            Click="BtnCerrar_click" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>

            <!-- Contenido de la red -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Simulación velocímetro -->
                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="100" Height="100"
                             Stroke="#007BFF" StrokeThickness="8"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="NetworkSpeedValue"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Mbps"
                                   Foreground="Gray"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Datos -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="ConnectionStatusLabel"
                               Text="Estado de conexión: -"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock>
                        <Run Text="Ping: " Foreground="White" FontWeight="Bold" />
                        <Run x:Name="PingLabel" Text="0 ms" Foreground="LightGreen"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Fluctuación: " Foreground="White" FontWeight="Bold"/>
                        <Run x:Name="JitterLabel" Text="0 ms" Foreground="LightGreen"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Descargar: " Foreground="White" FontWeight="Bold"/>
                        <Run x:Name="DownloadLabel" Text="0 Mbps" Foreground="LightGreen"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Subir: " Foreground="White" FontWeight="Bold"/>
                        <Run x:Name="UploadLabel" Text="-- Mbps" Foreground="Gray"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="2"
                       Text="Monitoreo de conectividad y velocidad de red"
                       Foreground="Gray"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>




