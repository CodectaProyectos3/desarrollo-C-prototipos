<Window x:Class="Prototipo.Espacio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estado General del Sistema - Espacio Disco"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1e1e2f">

    <Border CornerRadius="10" BorderThickness="1" Margin="10">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Blue" Offset="0"/>
                <GradientStop Color="Green" Offset="0.5"/>
                <GradientStop Color="Purple" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="10">
            <!-- Logo -->
            <Image Source="C:\Users\CODETA01\source\repos\jyp1\Prototipo\logojp.png"
                   Width="52"
                   Margin="6,-6,0,212"
                   HorizontalAlignment="Left"
                   Grid.RowSpan="2"/>

            <!-- Texto empresa -->
            <TextBlock Text="JyP Perifericos S.A.C"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Poppins"
                       Margin="0,0,0,20"/>

            <!-- Botones de control -->
            <Button Content="✖"
                    Width="30" Height="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Click="BtnCerrar_click"
                    Cursor="Hand"/>

            <Button Content="▁"
                    Width="30" Height="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,50,0"
                    Click="BtnPeque_Click"
                    Cursor="Hand"/>

            <!-- Contenido -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">

                <TextBlock x:Name="DriveLabel"
                           Text="Unidad C: -"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <Border Width="400" Height="30" Background="#444" CornerRadius="5" Margin="0,0,0,10">
                    <Rectangle x:Name="DriveBar"
                               Fill="Orange"
                               Width="0"
                               Height="30"
                               RadiusX="5" RadiusY="5"
                               HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="SpaceInfoLabel"
                           Text="Espacio usado / Total"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center" />

                <!-- Información adicional -->
                <TextBlock Text="Estado del espacio en disco de la unidad principal."
                           FontSize="14"
                           Foreground="White"
                           Margin="0,20,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

