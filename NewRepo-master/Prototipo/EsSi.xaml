<Window x:Class="Prototipo.EsSi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prototipo"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Title="Estado del Sistema"
        Height="350" Width="450"
        Background="#1e1e2f"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="10" BorderThickness="1" Margin="10">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="Red" Offset="0"/>
                <GradientStop Color="Blue" Offset="0.5"/>
                <GradientStop Color="Purple" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Source="C:\Users\CODETA01\source\repos\jyp1\Prototipo\logojp.png"
                   Width="52" Margin="6,-6,0,245"
                   HorizontalAlignment="Left"
                   Grid.RowSpan="2"/>

            <TextBlock Text="JyP Perifericos S.A.C"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Poppins"
                       Margin="0,0,0,20"/>

            <!-- Barra superior con botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="▁" Width="30" Height="30"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="White" FontSize="14"
                        Click="BtnPeque_Click" Cursor="Hand"/>
                <Button Content="✖" Width="30" Height="30"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="White" FontSize="14"
                        Click="BtnCerrar_click" Cursor="Hand"/>
            </StackPanel>

            <!-- Contenido principal -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">

                <!-- CPU -->
                <TextBlock x:Name="CpuLabel"
                           Text="CPU: 0%"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <Border Width="350" Height="25" Background="#444" CornerRadius="5">
                    <Rectangle x:Name="CpuBar"
                               Fill="LimeGreen"
                               Width="0"
                               Height="25"
                               RadiusX="5" RadiusY="5"
                               HorizontalAlignment="Left"/>
                </Border>

                <!-- RAM -->
                <TextBlock x:Name="RamLabel"
                           Text="RAM: 0 GB / 0 GB"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <Border Width="350" Height="25" Background="#444" CornerRadius="5">
                    <Rectangle x:Name="RamBar"
                               Fill="Orange"
                               Width="0"
                               Height="25"
                               RadiusX="5" RadiusY="5"
                               HorizontalAlignment="Left"/>
                </Border>

                <!-- Disco -->
                <TextBlock x:Name="DiskLabel"
                           Text="Disco C: 0 GB / 0 GB"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <Border Width="350" Height="25" Background="#444" CornerRadius="5">
                    <Rectangle x:Name="DiskBar"
                               Fill="SkyBlue"
                               Width="0"
                               Height="25"
                               RadiusX="5" RadiusY="5"
                               HorizontalAlignment="Left"/>
                </Border>

                <!-- Información adicional o estado -->
                <TextBlock x:Name="StatusLabel"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="10,20,10,0"
                           Text="Estado del sistema actualizado en tiempo real"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
