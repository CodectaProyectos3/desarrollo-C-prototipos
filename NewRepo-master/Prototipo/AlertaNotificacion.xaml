<Window x:Class="Prototipo.AlertaNotificacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="#AA282A36" Topmost="True"
        ShowInTaskbar="False" Width="280" Height="80"
        ResizeMode="NoResize" 
        WindowStartupLocation="Manual"
        Opacity="0"
        Loaded="Window_Loaded">

    <Border CornerRadius="8" BorderBrush="#ff5555" BorderThickness="2" Background="#2b2d3a" Padding="10">
        <StackPanel>
            <TextBlock x:Name="Titulo" Text="⚠️ Alerta del sistema"
                       FontWeight="Bold" Foreground="#ff5555" FontSize="15"/>
            <TextBlock x:Name="Mensaje" Text="Se detectó una nueva alerta"
                       Foreground="#cdd6f4" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
